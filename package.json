{
  "name": "melampus-typescript",
  "version": "0.1.0",
  "description": "Keep AI coding sessions aligned with reviewed intent and local execution evidence.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./watcher": {
      "types": "./dist/watcher.d.ts",
      "import": "./dist/watcher.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    }
  },
  "bin": {
    "melampus": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "semconv",
    "docs",
    "VERSION",
    "CHANGELOG.md",
    "src",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melampus-org/melampus-typescript.git"
  },
  "homepage": "https://melampus-org.github.io/melampus-typescript/",
  "bugs": {
    "url": "https://github.com/melampus-org/melampus-typescript/issues"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit && tsc -p tests/types/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --check-coverage --lines 85 --functions 85 --branches 75 npm test",
    "check:version": "node scripts/check-version.mjs",
    "check:semconv": "node scripts/generate-semconv.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "ci": "npm run check:version && npm run check:semconv && npm run lint && npm run build && npm run typecheck && npm run test:coverage && npm run check:package",
    "demo": "npm run build && node scripts/demo.mjs",
    "demo:registration": "npm run build && node scripts/demo-registration.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "dependencies": {
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
